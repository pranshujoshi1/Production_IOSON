# ─── IOSON Environment Variables ────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Contact Form (Formspree) ─────────────────────────────────────────────────
# 1. Sign up free at https://formspree.io
# 2. Create a New Form → set recipient to contact@iosonx.com
# 3. Copy the Form ID (looks like: xpwzlrjq)
# 4. Paste it below
VITE_FORMSPREE_ID=your_formspree_form_id

# ── Site URL ─────────────────────────────────────────────────────────────────
# Used for canonical URLs and OG meta tags
VITE_SITE_URL=https://ioson.in

# ── PostHog Analytics ────────────────────────────────────────────────────────
# Get your key from: https://app.posthog.com → Project Settings
# Leave empty to disable analytics in development
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Sentry Error Monitoring (Phase 5 — optional) ────────────────────────────
# Get your DSN from: https://sentry.io → Project → Settings → Client Keys
VITE_SENTRY_DSN=

# ── Environment identifier ───────────────────────────────────────────────────
VITE_ENV=development
